APP_NAME="OdontoSuite"
# En producción: APP_ENV=production y APP_DEBUG=false (nunca expongas trazas).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos: PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=odontosuite
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Los estudios, fotos de pacientes y firmas se guardan en el disco privado "local".
FILESYSTEM_DISK=local
# Los correos se encolan: ejecuta `php artisan queue:work` (o `composer dev`).
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@odontosuite.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Login social (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# --- Parámetros de la clínica ---
CLINICA_MONEDA=BOB
CLINICA_ZONA_HORARIA=America/La_Paz

# --- Recordatorios por WhatsApp / SMS ---
# Proveedor: log (solo registra en el log), twilio o meta (WhatsApp Cloud API).
MENSAJERIA_PROVEEDOR=log
# Prefijo de país que se antepone a los números locales de 8 dígitos.
MENSAJERIA_PREFIJO_PAIS=591
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_DESDE_SMS=
TWILIO_DESDE_WHATSAPP=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# --- Transmisión de documentos fiscales ---
# simulado (acepta todo, para desarrollo) | http (contrato JSON genérico) | ninguno
FACTURACION_PROVEEDOR=simulado
FACTURACION_ENDPOINT=
FACTURACION_TOKEN=

# --- Pagos en línea (portal del paciente) ---
# Proveedor: simulado (sin cobro real, para desarrollo y pruebas) o stripe.
PASARELA_PROVEEDOR=simulado
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Copias de seguridad ---
# Cuántos respaldos (ZIP en storage/app/respaldos) se conservan; los más antiguos se borran.
RESPALDOS_CONSERVAR=14
# Carpeta con pg_dump y pg_restore si no están en el PATH (p. ej. /usr/lib/postgresql/16/bin).
RESPALDOS_RUTA_PG=

# --- Licencia CONTROL (sistema central de licencias de la agencia) ---
# true exige licencia en el panel, el portal, la reserva pública y la API.
# En desarrollo y pruebas déjalo en false.
CONTROL_ACTIVO=false
# URL base del panel CONTROL (sin barra final).
CONTROL_URL=https://control.tuagencia.com
# Clave de licencia CTL-XXXX-XXXX-XXXX-XXXX. También se puede registrar desde
# la pantalla /licencia o con `php artisan licencia:activar`, en cuyo caso
# queda en storage/app/control/licencia.json.
CONTROL_LICENCIA=
# Clave pública Ed25519 de CONTROL (base64). Se obtiene una sola vez con
# GET ${CONTROL_URL}/api/v1/licencias/clave-publica → clave_publica.
CONTROL_CLAVE_PUBLICA=
# Identificador del equipo o dominio. Vacío: en localhost se usa un hash del
# nombre del equipo (escritorio); en un servidor, el dominio de APP_URL.
CONTROL_HUELLA=
# Versión instalada que se informa a CONTROL (aviso de versión nueva).
APP_VERSION=2.0.0
